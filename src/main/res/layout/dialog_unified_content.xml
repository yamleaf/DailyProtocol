<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- 状态图标：tonal 圆形容器 -->
    <ImageView
        android:id="@+id/ivDialogIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_circle_56"
        android:scaleType="centerInside"
        android:contentDescription="@null" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/md_onSurface" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="6dp" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/md_onSurfaceVariant" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="18dp" />

    <!-- 底部按钮栏：双按钮等宽均分；单按钮由 kit 改为居中自然宽度 -->
    <LinearLayout
        android:id="@+id/btnBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnNegative"
            style="@style/Widget.Daily.Dialog.Button.Negative"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPositive"
            style="@style/Widget.Daily.Dialog.Button.Positive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
