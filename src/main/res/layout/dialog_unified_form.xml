<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- 标题：有则居中显示 -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/md_onSurface"
        android:visibility="gone" />

    <Space
        android:id="@+id/titleGap"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:visibility="gone" />

    <!-- 辅助说明：左对齐 -->
    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/md_onSurfaceVariant"
        android:visibility="gone" />

    <Space
        android:id="@+id/messageGap"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:visibility="gone" />

    <!-- 自定义内容容器：可滚动，最大高度限制避免按钮被推出屏幕 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="420dp">

        <FrameLayout
            android:id="@+id/contentHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- 底部按钮栏：双按钮等宽均分；单按钮由 kit 改为居中自然宽度 -->
    <LinearLayout
        android:id="@+id/btnBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnNegative"
            style="@style/Widget.Daily.Dialog.Button.Negative"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPositive"
            style="@style/Widget.Daily.Dialog.Button.Positive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
