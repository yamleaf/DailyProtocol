<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 分区卡片：白底、圆角16、细描边、轻阴影（parent 用公开 Widget.MaterialComponents.CardView，避免跨模块引用 Material3 私有样式导致 app 链接失败） -->
    <style name="Widget.Daily.SectionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/md_surface</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elev_surface</item>
        <item name="strokeColor">@color/md_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 图标容器：圆角方形（12dp），品牌浅底 -->
    <style name="Widget.Daily.IconContainer" parent="android:Widget">
        <item name="android:background">@color/md_primaryContainer</item>
        <item name="android:layout_width">@dimen/icon_container</item>
        <item name="android:layout_height">@dimen/icon_container</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- 列表项标题 / 副标题文字 -->
    <style name="Widget.Daily.ListTitle" parent="android:Widget.TextView">
        <item name="android:textSize">@dimen/sp_14</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_onSurface</item>
    </style>

    <style name="Widget.Daily.ListSubtitle" parent="android:Widget.TextView">
        <item name="android:textSize">@dimen/sp_12</item>
        <item name="android:textColor">@color/md_onSurfaceVariant</item>
    </style>

    <!-- ===== 统一弹窗（双端共用）：M3 现代规范 =====
         - 28dp ExtraLarge 圆角（M3 大圆角弹窗）
         - 表面用 md_surfaceContainerHigh（tonal 抬升，替代平铺 surface）
         - 底部按钮 44dp 胶囊，双按钮等宽均分
         - 入场 220ms 标准动效（fast_out_slow_in） -->
    <!-- 父样式用 ShapeAppearance.Material3.Corner.Small（material 1.12 / 1.13 均可用），显式指定 cornerFamily/size -->
    <style name="ShapeAppearance.Daily.Dialog" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.Daily.Input" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- 主按钮：实心 Primary 胶囊 -->
    <style name="Widget.Daily.Dialog.Button.Positive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_onPrimary</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- 次按钮：描边胶囊（柔和描边 + 次级文字） -->
    <style name="Widget.Daily.Dialog.Button.Negative" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/md_onSurfaceVariant</item>
        <item name="strokeColor">@color/md_outlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- 文字按钮：取消 / 知道了 -->
    <style name="Widget.Daily.Dialog.Button.Neutral" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/md_primary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- 统一输入框样式（12dp 圆角，双端一致） -->
    <style name="Widget.Daily.TextInput.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearance">@style/ShapeAppearance.Daily.Input</item>
    </style>

    <!-- 弹窗入场/出场动画：标准动效（fast_out_slow_in / linear_out_slow_in） -->
    <style name="Animation.Daily.DialogScale" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!-- 统一弹窗主题：28dp 圆角 + tonal 抬升表面 + 胶囊按钮 + 缩放动画 -->
    <style name="ThemeOverlay.Daily.UnifiedDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.Daily.Dialog</item>
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorSurface">@color/md_surfaceContainerHigh</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Daily.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Daily.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Daily.Dialog.Button.Neutral</item>
        <item name="android:windowAnimationStyle">@style/Animation.Daily.DialogScale</item>
    </style>
</resources>
