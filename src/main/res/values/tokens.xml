    <!-- ════ 历史色（兼容保留，P3 清理）════ -->
    <color name="ios_green">#4DDC64</color>
    <color name="black">#000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="white_70">#B3FFFFFF</color>
    <color name="red">#FF0000</color>
    <color name="orange">#FFC107</color>
