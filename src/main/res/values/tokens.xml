<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════
  设计令牌（浅色模式）— UI_REDESIGN_PLAN v1.2 §2.1
  双主色体系：商务蓝 #2C5F8A（主操作）+ 品牌紫 #5B5BD6（品牌位）
  标志性元素（AppBar/FAB/选中胶囊/色条）用紫→蓝渐变
  库为唯一源，双端 app 不再重复定义；旧别名桥接已在 P3 全量替换并删除
  ═══════════════════════════════════════════════════════════════
-->
<resources>

    <!-- ════ A. 双主色与品牌色 ════ -->
    <!-- 商务蓝（主操作）：主按钮、Toggle 开态、导航选中、链接、聚焦描边 -->
    <color name="md_primary">#2C5F8A</color>
    <color name="md_primary_dark">#1F4A6E</color>
    <color name="md_onPrimary">#FFFFFF</color>
    <color name="md_primaryContainer">#E8F0F7</color>
    <color name="md_onPrimaryContainer">#1F4A6E</color>
    <!-- 品牌紫（身份色）：品牌位图标、色条、状态环、入口卡 -->
    <color name="brand_purple">#5B5BD6</color>
    <color name="brand_purple_container">#F1F0FB</color>
    <color name="brand_on_purple_container">#5B5BD6</color>
    <!-- 紫→蓝签名渐变（仅限 4 处标志性元素） -->
    <color name="grad_brand_start">#5B5BD6</color>
    <color name="grad_brand_end">#2C5F8A</color>
    <!-- 色条/Toggle 渐变别名（语义兼容，值同签名渐变） -->
    <color name="accent_gradient_start">#5B5BD6</color>
    <color name="accent_gradient_end">#2C5F8A</color>

    <!-- ════ B. 功能色 ════ -->
    <color name="md_secondary">#5A5F8A</color>
