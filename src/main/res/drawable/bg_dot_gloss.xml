<?xml version="1.0" encoding="utf-8"?>
<!-- 球状状态灯顶部高光层（白色半透明椭圆，模拟光源反射） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#66FFFFFF"
        android:centerColor="#22FFFFFF"
        android:endColor="#00FFFFFF" />
    <size
        android:width="8dp"
        android:height="8dp" />
</shape>
