<?xml version="1.0" encoding="utf-8"?>
<!-- 在线状态：绿色球面（高光+径向渐变+内阴影模拟 3D 球体） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层：深色边缘（模拟球体阴影/厚度） -->
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="oval">
            <solid android:color="#1A000000" />
        </shape>
    </item>
    <!-- 主球体：径向渐变（左上亮→右下暗） -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="6dp"
                android:centerX="0.35"
                android:centerY="0.3"
                android:startColor="#A5F3C7"
                android:centerColor="#34D399"
                android:endColor="#059669" />
            <size
                android:width="10dp"
                android:height="10dp" />
        </shape>
    </item>
    <!-- 顶部高光（光源反射） -->
    <item
        android:left="2.5dp"
        android:top="2dp"
        android:right="4.5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#B3FFFFFF"
                android:endColor="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
