<?xml version="1.0" encoding="utf-8"?>
<!-- 深空仪表盘卡背景：深蓝空渐变 + 网格纹理（tileMode repeat，浅色 5%） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="@color/dash_end"
                android:startColor="@color/dash_start"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <bitmap
            android:alpha="0.05"
            android:src="@drawable/bg_dash_grid_tile"
            android:tileMode="repeat" />
    </item>
</layer-list>
